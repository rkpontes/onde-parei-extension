{
  "manifest_version": 3,
  "name": "Onde Parei? (Mangás e Animes)",
  "version": "1.0.0",
  "description": "Organize animes e mangás, salve seus links e marque manualmente o progresso.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "action": {
    "default_title": "Onde Parei?",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "114",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
